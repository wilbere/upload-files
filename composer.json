{
    "name": "wilbere/upload-files",
    "description": "Paquete para facilitar crear un CRUD de archivos y imagenes en BD",
    "type": "library",
    "license": "MIT",
    "version": "0.3.0",
    "autoload": {
        "psr-4": {
            "Wilbere\\UploadFiles\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Wilber Galindez",
            "email": "wilber@wgalindez.dev",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "9.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wilbere\\UploadFiles\\Providers\\UploadFilesServiceProvider"
            ]
        }
    }
}